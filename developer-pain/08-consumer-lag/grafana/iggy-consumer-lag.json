{
  "title": "Apache Iggy consumer lag (LaserData)",
  "uid": "iggy-consumer-lag",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "apache-iggy",
    "laserdata",
    "streaming"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "stream",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(iggy_consumer_group_lag, stream)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "topic",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(iggy_consumer_group_lag{stream=~\"$stream\"}, topic)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "group",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(iggy_consumer_group_lag{stream=~\"$stream\",topic=~\"$topic\"}, group)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total lag (messages)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(iggy_consumer_group_lag{stream=~\"$stream\",topic=~\"$topic\",group=~\"$group\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Groups with growing lag (10m)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(sum by (stream,topic,group) (deriv(iggy_consumer_group_lag{stream=~\"$stream\",topic=~\"$topic\",group=~\"$group\"}[10m])) > 0) or vector(0)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Members",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(iggy_consumer_group_members{stream=~\"$stream\",topic=~\"$topic\",group=~\"$group\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Exporter up",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "min(iggy_lag_exporter_up)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Lag by group",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (stream,topic,group) (iggy_consumer_group_lag{stream=~\"$stream\",topic=~\"$topic\",group=~\"$group\"})",
          "legendFormat": "{{stream}}/{{topic}} \u00b7 {{group}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Lag by partition",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "iggy_consumer_group_lag{stream=~\"$stream\",topic=~\"$topic\",group=~\"$group\"}",
          "legendFormat": "{{group}} \u00b7 p{{partition}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Consume rate vs produce rate (msg/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (stream,topic,group) (deriv(iggy_consumer_group_committed_offset{stream=~\"$stream\",topic=~\"$topic\",group=~\"$group\"}[5m]))",
          "legendFormat": "consumed \u00b7 {{group}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (stream,topic) (deriv(iggy_partition_current_offset{stream=~\"$stream\",topic=~\"$topic\"}[5m]))",
          "legendFormat": "produced \u00b7 {{stream}}/{{topic}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Most-behind partitions",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, iggy_consumer_group_lag{stream=~\"$stream\",topic=~\"$topic\",group=~\"$group\"})",
          "format": "table",
          "instant": true
        }
      ]
    }
  ]
}